{"nodes": [{"id": "agb_dokument", "label": "Allgemeine Gesch\u00e4ftsbedingungen (Dokument)", "file_type": "document", "source_file": "agb.html", "source_location": "agb.html", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agb_anbieter_verantwortlicher", "label": "Anbieter / Verantwortlicher (AGB-Kopfblock)", "file_type": "document", "source_file": "agb.html", "source_location": "#anbieter-daten", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agb_geltungsbereich", "label": "Geltungsbereich der AGB", "file_type": "concept", "source_file": "agb.html", "source_location": "#geltung", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Erfasst Website-Nutzung, kostenlose Potenzialanalyse und sp\u00e4tere Leistungen in einem Dokument, damit kein separates Regelwerk je Leistungsstufe n\u00f6tig ist; abweichende schriftliche Vereinbarungen gehen vor."}, {"id": "agb_platzhalter_name_firma", "label": "Unausgef\u00fcllter Platzhalter [Name / Firma] im Geltungsbereich", "file_type": "document", "source_file": "agb.html", "source_location": "#geltung", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Redaktioneller Rest: die Vertragspartei wird im Geltungsbereich nicht benannt, obwohl Impressum und Kopfblock den Anbieter vollst\u00e4ndig ausweisen."}, {"id": "agb_kostenlose_ki_potenzialanalyse", "label": "Kostenlose KI-Potenzialanalyse (AGB \u00a7 2)", "file_type": "concept", "source_file": "agb.html", "source_location": "#analyse", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Die Analyse wird bewusst als unentgeltliche Orientierungsleistung ausgestaltet, um sie aus dem Vertrags- und Beratungshaftungsregime herauszuhalten."}, {"id": "agb_keine_zahlungspflicht", "label": "Keine Zahlungspflicht, kein Abo, keine automatische Newsletter-Anmeldung", "file_type": "rationale", "source_file": "agb.html", "source_location": "#analyse", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ausdr\u00fcckliche Absicherung gegen Abo-Fallen-Vorwurf und gegen die Annahme einer konkludenten Newsletter-Einwilligung durch Formularabsendung."}, {"id": "agb_keine_sonderberatung", "label": "Kein Rechts-, Steuer-, Finanz-, Anlage-, Versicherungs- oder Unternehmensberatungsverh\u00e4ltnis", "file_type": "concept", "source_file": "agb.html", "source_location": "#analyse", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Abgrenzung gegen erlaubnispflichtige Beratungstatbest\u00e4nde (RDG, StBerG, WpIG, GewO) und gegen Beratervertragshaftung."}, {"id": "agb_keine_ergebnisgarantie", "label": "Keine Zusicherung technischer, wirtschaftlicher oder organisatorischer Umsetzbarkeit", "file_type": "concept", "source_file": "agb.html", "source_location": "#analyse", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Vermeidet, dass Empfehlungen als zugesicherte Eigenschaft oder Beschaffenheitsvereinbarung ausgelegt werden."}, {"id": "agb_vertragsschluss", "label": "Vertragsschluss bei kostenpflichtigen Leistungen", "file_type": "concept", "source_file": "agb.html", "source_location": "#vertrag", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Vertrag entsteht erst mit ausdr\u00fccklicher Annahme eines individuellen Angebots; Gespr\u00e4che, Formulareingaben und Empfehlungen sind ausdr\u00fccklich kein Angebot bzw. keine Annahme."}, {"id": "agb_mitwirkungspflicht", "label": "Mitwirkungspflicht des Anfragenden", "file_type": "concept", "source_file": "agb.html", "source_location": "#pflichten", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Verlagert das Risiko unvollst\u00e4ndiger Eingaben auf den Anfragenden und st\u00fctzt zugleich die Haftungsbeschr\u00e4nkung f\u00fcr die Einsch\u00e4tzungsqualit\u00e4t."}, {"id": "agb_drittdaten_uebermittlungsverbot", "label": "Verbot der \u00dcbermittlung von Gesch\u00e4ftsgeheimnissen und Drittdaten ohne Berechtigung", "file_type": "concept", "source_file": "agb.html", "source_location": "#pflichten", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sch\u00fctzt den Anbieter vor unbefugter Auftrags- bzw. Fremddatenverarbeitung, die datenschutzrechtlich beim Anfragenden verantwortet werden muss."}, {"id": "agb_haftungsbeschraenkung", "label": "Haftungsbeschr\u00e4nkung f\u00fcr kostenlose Ersteinsch\u00e4tzungen", "file_type": "concept", "source_file": "agb.html", "source_location": "#haftung", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Unentgeltlichkeit rechtfertigt den Haftungsausschluss f\u00fcr wirtschaftliche Entscheidungen, die allein auf die Ersteinsch\u00e4tzung gest\u00fctzt werden."}, {"id": "agb_zwingende_haftung", "label": "Zwingende Haftung (Vorsatz, grobe Fahrl\u00e4ssigkeit, Leben/K\u00f6rper/Gesundheit)", "file_type": "concept", "source_file": "agb.html", "source_location": "#haftung", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "R\u00fcckausnahme zur Wirksamkeit der Haftungsklausel nach AGB-Recht (\u00a7\u00a7 307 ff. BGB)."}, {"id": "agb_ki_gestuetzte_inhalte", "label": "KI-gest\u00fctzte Inhalte als Arbeitshilfe", "file_type": "concept", "source_file": "agb.html", "source_location": "#ki", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "KI-Ausgaben werden ausdr\u00fccklich nicht als verbindliche Tatsachenbehauptung eingestuft; Human-in-the-Loop als Haftungsgrenze."}, {"id": "agb_schlussbestimmungen", "label": "Schlussbestimmungen und deutsches Recht", "file_type": "concept", "source_file": "agb.html", "source_location": "#schluss", "source_url": null, "captured_at": null, "author": n