{"nodes": [{"id": "assets_downloads_roi_guide_ki_automatisierung_nurovelle_formatvorlagen_final_guide", "label": "ROI-Guide fuer KI-Automatisierung", "file_type": "document", "source_file": "assets/downloads/ROI_GUIDE_KI_AUTOMATISIERUNG_NUROVELLE_Formatvorlagen_FINAL.pdf", "source_location": "Gesamtdokument, 59 Seiten", "source_url": null, "captured_at": null, "author": "Tino Schneider", "contributor": null, "rationale": "Als Entscheidungsgrundlage fuer Geschaeftsfuehrer im Mittelstand konzipiert: Fokus bewusst auf Wirtschaftlichkeit statt auf einzelne Tools, weil KI-Budget sonst in Experimenten verloren geht."}, {"id": "assets_downloads_roi_guide_ki_automatisierung_nurovelle_formatvorlagen_final_warum_ki_projekte_wirtschaftlich_enttaeuschen", "label": "Warum viele KI-Projekte wirtschaftlich enttaeuschen", "file_type": "rationale", "source_file": "assets/downloads/ROI_GUIDE_KI_AUTOMATISIERUNG_NUROVELLE_Formatvorlagen_FINAL.pdf", "source_location": "Kapitel 1", "source_url": null, "captured_at": null, "author": "Tino Schneider", "contributor": null, "rationale": "KI-Projekte scheitern nicht an der Technologie, sondern an Aktionismus statt Strategie, Tool-Kauf ohne Prozessanalyse und fehlender Wirtschaftlichkeitsbetrachtung. Die bessere Startfrage ist nicht 'Welche KI setzen wir ein?', sondern 'Welcher Prozess kostet uns heute zu viel Zeit, Geld oder Qualitaet?'. Eine Woche strukturierte Prozessanalyse verhindert Monate verlorener Projektzeit."}, {"id": "assets_downloads_roi_guide_ki_automatisierung_nurovelle_formatvorlagen_final_roi_bei_ki_automatisierung", "label": "ROI bei KI-Automatisierung", "file_type": "concept", "source_file": "assets/downloads/ROI_GUIDE_KI_AUTOMATISIERUNG_NUROVELLE_Formatvorlagen_FINAL.pdf", "source_location": "Kapitel 2", "source_url": null, "captured_at": null, "author": "Tino Schneider", "contributor": null}, {"id": "assets_downloads_roi_guide_ki_automatisierung_nurovelle_formatvorlagen_final_roi_formel", "label": "ROI-Formel fuer KI-Projekte", "file_type": "concept", "source_file": "assets/downloads/ROI_GUIDE_KI_AUTOMATISIERUNG_NUROVELLE_Formatvorlagen_FINAL.pdf", "source_location": "Kapitel 3", "source_url": null, "captured_at": null, "author": "Tino Schneider", "contributor": null, "rationale": "ROI = (Nutzen - Kosten) / Kosten x 100. Kosten und Nutzen muessen sauber getrennt werden, damit die Formel im Unternehmen nutzbar wird."}, {"id": "assets_downloads_roi_guide_ki_automatisierung_nurovelle_formatvorlagen_final_kostenbasis", "label": "Kostenbasis: einmalige und laufende Kosten", "file_type": "concept", "source_file": "assets/downloads/ROI_GUIDE_KI_AUTOMATISIERUNG_NUROVELLE_Formatvorlagen_FINAL.pdf", "source_location": "Kapitel 3, Schritt 1", "source_url": null, "captured_at": null, "author": "Tino Schneider", "contributor": null, "rationale": "Interne Zeitaufwaende fuer Workshops, Tests und Abstimmungen werden regelmaessig unterschaetzt; KI-Automatisierung ist kein einmaliger Kauf, sondern braucht Betrieb, Pflege und Kontrolle."}, {"id": "assets_downloads_roi_guide_ki_automatisierung_nurovelle_formatvorlagen_final_nutzenbasis", "label": "Nutzenbasis: direkte, indirekte Einsparungen und Umsatzwirkung", "file_type": "concept", "source_file": "assets/downloads/ROI_GUIDE_KI_AUTOMATISIERUNG_NUROVELLE_Formatvorlagen_FINAL.pdf", "source_location": "Kapitel 3, Schritt 2", "source_url": null, "captured_at": null, "author": "Tino Schneider", "contributor": null, "rationale": "Umsatzwirkung wird getrennt von Kosteneinsparungen ausgewiesen, weil sie unsicherer ist als Zeiteinsparung. Indirekte Einsparungen duerfen trotz Schaetzunsicherheit nicht ignoriert werden, muessen aber konservativ angesetzt sein."}, {"id": "assets_downloads_roi_guide_ki_automatisierung_nurovelle_formatvorlagen_final_baseline_messung", "label": "Baseline-Messung vor dem KI-Pilot", "file_type": "concept", "source_file": "assets/downloads/ROI_GUIDE_KI_AUTOMATISIERUNG_NUROVELLE_Formatvorlagen_FINAL.pdf", "source_location": "Kapitel 3, Schritt 3", "source_url": null, "captured_at": null, "author": "Tino Schneider", "contributor": null, "rationale": "Ohne Baseline gibt es keinen sauberen Vorher-Nachher-Vergleich; ein KI-Pilot ohne Baseline ist kaum bewertbar."}, {"id": "assets_downloads_roi_guide_ki_automatisierung_nurovelle_formatvorlagen_final_zielwert_definition", "label": "Messbare Zielwertdefinition", "file_type": "concept", "source_file": "assets/downloads/ROI_GUIDE_KI_AUTOMATISIERUNG_NUROVELLE_Formatvorlagen_FINAL.pdf", "source_location": "Kapitel 3, Schritt 4", "source_url": null, "captured_at": null, "author": "Tino Schneider", "contributor": null, "rationale": "Der Zielwert muss messbar sein, weil unklare Ziele zu unklaren Ergebnissen fuehren (z. B. Bearbeitungszeit -40 %, Fehlerquote von 5 % auf 2 %)."}, {"id": "assets_downloads_roi_guide_ki_automatisierung_nurovelle_formatvorlagen_final_amortisationsrechnung", "label": "Amortisations- und ROI-Beispielrechnung", "file_type": "concept", "source_file": "assets/downloads/ROI_GUIDE_KI_AUTOMATISIERUNG_NUROVELLE_Formatvorlagen_FINAL.pdf", "source_location": "Kapitel 3, Schritt 5", "source_url": null, "captured_at": null, "author": "Tino Schneider", "contributor": null, "rationale": "Modellrechnung: 8.990 EUR einmalig, 499 EUR/Monat laufend, 68 eingesparte Stunden bei 45 EUR Stundensatz ergeben 4,1 Monate Amortisation und ca. 192 % ROI im ersten Jahr. Werte muessen mit realen Prozessdaten validiert werden."}, {"id": "assets_downloads_roi_guide_ki_automatisierung_nurovelle_formatvorlagen_final_roi_korridore_nach_prozessart", "label": "Beispielhafte ROI-Korridore nach Prozessart", "file_type": "concept", "source_file": "assets/downloads/ROI_GUIDE_KI_AUTOMATISIERUNG_NUROVELLE_Formatvorlagen_FINAL.pdf", "source_location": "Kapitel 3", "source_url": null, "captured_at": null, "author": "Tino Schneider", "contributor": null, "rationale": "Nur Orientierungswerte, keine Garantie: sie zeigen lediglich, wo sich eine vertiefende Pruefung haeufig lohnt (z. B. technische Dokumentation 120-350 %, Wissensmanagement 60-180 %)."}, {"id": "assets_downloads_roi_guide_ki_automatisierung_nurovelle_formatvorlagen_final_zehn_prozesse_mit_hohem_roi_potenzial", "label": "Die 10 Prozesse mit hohem ROI-Potenzial", "file_type": "concept", "source_file": "assets/downloads/ROI_GUIDE_KI_AUTOMATISIERUNG_NUROVELLE_Formatvorlagen_FINAL.pdf", "source_location": "Kapitel 4", "source_url": null, "captured_at": null, "author": "Tino Schneider", "contributor": null, "rationale": "Auswahlkriterium ist nicht, ob ein Prozess modern klingt, sondern ob er haeufig vorkommt, viel Arbeitszeit bindet, wiederkehrenden Mustern folgt, vorhandene Daten nutzt, messbar ist und schrittweise automatisierbar bleibt."}, {"id": "assets_downloads_roi_guide_ki_automatisierung_nurovelle_formatvorlagen_final_angebotsbearbeitung", "label": "Prozess: Angebotsbearbeitung", "file_type": "concept", "source_file": "assets/downloads/ROI_GUIDE_KI_AUTOMATISIERUNG_NUROVELLE_Formatvorlagen_FINAL.pdf", "source_location": "Kapitel 4", "source_url": null, "captured_at": null, "author": "Tino Schneider", "contributor": null}, {"id": "assets_downloads_roi_guide_ki_automatisierung_nurovelle_formatvorlagen_final_email_bearbeitung", "label": "Prozess: E-Mail-Bearbeitung", "file_type": "concept", "source_file": "assets/downloads/ROI_GUIDE_KI_AUTOMATISIERUNG_NUROVELLE_Formatvorlagen_FINAL.pdf", "source_location": "Kapitel 4", "source_url": null, "captured_at": null, "author": "Tino Schneider", "contributor": null}, {"id": "assets_downloads_roi_guide_ki_automatisierung_nurovelle_formatvorlagen_final_dokumentation", "label": "Prozess: Dokumentation", "file_type": "concept", "source_file": "assets/downloads/ROI_GUIDE_KI_AUTOMATISIERUNG_NUROVELLE_Formatvorlagen_FINAL.pdf", "source_location": "Kapitel 4", "source_url": null, "captured_at": null, "author": "Tino Schneider", "contributor": null}, {"id": "assets_downloads_roi_guide_ki_automatisierung_nurovelle_formatvorlagen_final_wissensmanagement", "label": "Prozess: Wissensmanagement", "file_type": "concept", "source_file": "assets/downloads/ROI_GUIDE_KI_AUTOMATISIERUNG_NUROVELLE_Formatvorlagen_FINAL.pdf", "source_location": "Kapitel 4", "source_url": null, "captured_at": null, "author": "Tino Schneider", "contributor": null}, {"id": "assets_downloads_roi_guide_ki_automatisierung_nurovelle_formatvorlagen_final_kundenservice_1st_level", "label": "Prozess: Kundenservice 1st Level", "file_type": "concept", "source_file": "assets/downloads/ROI_GUIDE_KI_AUTOMATISIERUNG_NUROVELLE_Formatvorlagen_FINAL.pdf", "source_location": "Kapitel 4", "source_url": null, "captured_at": null, "author": "Tino Schneider", "contributor": null}, {"id": "assets_downloads_roi_guide_ki_automatisierung_nurovelle_formatvorlagen_final_leadbearbeitung", "label": "Prozess: Leadbearbeitung", "file_type": "concept", "source_file": "assets/downloads/ROI_GUIDE_KI_AUTOMATISIERUNG_NUROVELLE_Formatvorlagen_FINAL.pdf", "source_location": "Kapitel 4", "source_url": null, "captured_at": null, "author": "Tino Schneider", "contributor": null}, {"id": "assets_downloads_roi_guide_ki_automatisierung_nurovelle_formatvorlagen_final_terminplanung", "label": "Prozess: Terminplanung", "file_type": "concept", "source_file": "assets/downloads/ROI_GUIDE_KI_AUTOMATISIERUNG_NUROVELLE_Formatvorlagen_FINAL.pdf", "source_location": "Kapitel 4", "source_url": null, "captured_at": null, "author": "Tino Schneider", "contributor": null}, {"id": "assets_downloads_roi_guide_ki_automatisierung_nurovelle_formatvorlagen_final_reporting", "label": "Prozess: Reporting", "file_type": "concept", "source_file": "assets/downloads/ROI_GUIDE_KI_AUTOMATISIERUNG_NUROVELLE_Formatvorlagen_FINAL.pdf", "source_location": "Kapitel 4", "source_url": null, "captured_at": null, "author": "Tino Schneider", "contributor": null}, {"id": "assets_downloads_roi_guide_ki_automatisierung_nurovelle_formatvorlagen_final_rechnungsverarbeitung", "label": "Prozess: Rechnungsverarbeitung", "file_type": "concept", "source_file": "assets/downloads/ROI_GUIDE_KI_AUTOMATISIERUNG_NUROVELLE_Formatvorlagen_FINAL.pdf", "source_location": "Kapitel 4", "source_url": null, "captured_at": null, "author": "Tino Schneider", "contributor": null}, {"id": "assets_downloads_roi_guide_ki_automatisierung_nurovelle_formatvorlagen_final_datenpflege", "label": "Prozess: Datenpflege", "file_type": "concept", "source_file": "assets/downloads/ROI_GUIDE_KI_AUTOMATISIERUNG_NUROVELLE_Formatvorlagen_FINAL.pdf", "source_location": "Kapitel 4", "source_url": null, "captured_at": null, "author": "Tino Schneider", "contributor": null}, {"id": "assets_downloads_roi_guide_ki_automatisierung_nurovelle_formatvorlagen_final_ki_potenzial_selbsttest", "label": "KI-Potenzial-Selbsttest", "file_type": "concept", "source_file": "assets/downloads/ROI_GUIDE_KI_AUTOMATISIERUNG_NUROVELLE_Formatvorlagen_FINAL.pdf", "source_location": "Kapitel 5", "source_url": null, "captured_at": null, "author": "Tino Schneider", "contributor": null, "rationale": "Bewertet zwei Dimensionen getrennt: Automatisierungspotenzial (genug manuelle, wiederkehrende, kostenrelevante Taetigkeiten) und KI-Umsetzungsreife (Prozesse, Daten, Infrastruktur, Entscheidungswege). Skala 1-5 ueber die Bloecke Prozesse und Daten."}, {"id": "assets_downloads_roi_guide_ki_automatisierung_nurovelle_formatvorlagen_final_roi_schnellrechner", "label": "ROI-Schnellrechner", "file_type": "concept", "source_file": "assets/downloads/ROI_GUIDE_KI_AUTOMATISIERUNG_NUROVELLE_Formatvorlagen_FINAL.pdf", "source_location": "Kapitel 6", "source_url": null, "captured_at": null, "author": "Tino Schneider", "contributor": null, "rationale": "Ersetzt keine Detailanalyse, macht Prozesse aber wirtschaftlich vergleichbar: Monatskosten = Mitarbeiter x Stunden/Woche x Stundensatz x 4."}, {"id": "assets_downloads_roi_guide_ki_automatisierung_nurovelle_formatvorlagen_final_modellfall_ingenieurbuero", "label": "Modellfall 1: Ingenieurbuero fuer technische Planung", "file_type": "concept", "source_file": "assets/downloads/ROI_GUIDE_KI_AUTOMATISIERUNG_NUROVELLE_Formatvorlagen_FINAL.pdf", "source_location": "Kapitel 7", "source_url": null, "captured_at": null, "author": "Tino Schneider", "contributor": null, "rationale": "15 Mitarbeiter, Engpass ist nicht das Wissen sondern der Zugriff darauf. 10.000 EUR einmalig, 600 EUR/Monat, 80 eingesparte Recherchestunden bei 75 EUR -> ca. 2 Monate Amortisation, 200-400 % ROI. Haengt stark von der Dokumentenstruktur und konsequenter Nutzung ab."}, {"id": "assets_downloads_roi_guide_ki_automatisierung_nurovelle_formatvorlagen_final_modellfall_shk_handwerksbetrieb", "label": "Modellfall 2: SHK-Handwerksbetrieb", "file_type": "concept", "source_file": "assets/downloads/ROI_GUIDE_KI_AUTOMATISIERUNG_NUROVELLE_Formatvorlagen_FINAL.pdf", "source_location": "Kapitel 7", "source_url": null, "captured_at": null, "author": "Tino Schneider", "contributor": null, "rationale": "40-50 Mitarbeiter, Disponenten binden Zeit in wiederkehrenden Abstimmungen. 7.000 EUR einmalig, 500 EUR/Monat, 70 Stunden bei 38 EUR -> 3-4 Monate Amortisation, 120-250 % ROI. Ein vollstaendiger Telefonagent bleibt bewusst spaetere Ausbaustufe."}, {"id": "assets_downloads_roi_guide_ki_automatisierung_nurovelle_formatvorlagen_final_modellfall_steuerberatung", "label": "Modellfall 3: Steuerberatung / buchhaltungsnaher Dienstleister", "file_type": "concept", "source_file": "assets/downloads/ROI_GUIDE_KI_AUTOMATISIERUNG_NUROVELLE_Formatvorlagen_FINAL.pdf", "source_location": "Kapitel 7", "source_url": null, "captured_at": null, "author": "Tino Schneider", "contributor": null}, {"id": "assets_downloads_roi_guide_ki_automatisierung_nurovelle_formatvorlagen_final_quick_wins", "label": "Quick Wins: 20 Automatisierungen mit kurzer Umsetzungszeit", "file_type": "concept", "source_file": "assets/downloads/ROI_GUIDE_KI_AUTOMATISIERUNG_NUROVELLE_Formatvorlagen_FINAL.pdf", "source_location": "Kapitel 8", "source_url": null, "captured_at": null, "author": "Tino Schneider", "contributor": null, "rationale": "Kleine Automatisierungen mit geringem Risiko dienen dazu, Erfahrung zu sammeln, Akzeptanz aufzubauen und Wirtschaftlichkeit praktisch zu pruefen, bevor groessere Projekte starten."}, {"id": "assets_downloads_roi_guide_ki_automatisierung_nurovelle_formatvorlagen_final_priorisierungsmatrix", "label": "Priorisierungsmatrix Aufwand und Nutzen", "file_type": "concept", "source_file": "assets/downloads/ROI_GUIDE_KI_AUTOMATISIERUNG_NUROVELLE_Formatvorlagen_FINAL.pdf", "source_location": "Kapitel 9", "source_url": null, "captured_at": null, "author": "Tino Schneider", "contributor": null, "rationale": "Vier Felder ueber die Achsen Nutzen und Aufwand: hoher Nutzen/niedriger Aufwand sofort priorisieren, hoher Nutzen/hoher Aufwand erst analysieren-budgetieren-pilotieren, niedriger Nutzen/niedriger Aufwand nebenbei, niedriger Nutzen/hoher Aufwand zurueckstellen um Ressourcen zu schuetzen. Bewertung ueber 10 Kriterien mit 1-5 Punkten."}, {"id": "assets_downloads_roi_guide_ki_automatisierung_nurovelle_formatvorlagen_final_neunzig_tage_plan", "label": "90-Tage-Plan zur ersten messbaren KI-Automatisierung", "file_type": "concept", "source_file": "assets/downloads/ROI_GUIDE_KI_AUTOMATISIERUNG_NUROVELLE_Formatvorlagen_FINAL.pdf", "source_location": "Kapitel 10", "source_url": null, "captured_at": null, "author": "Tino Schneider", "contributor": null, "rationale": "Bewusst pragmatisch: Ziel ist nicht die perfekte KI-Strategie auf dem Papier, sondern ein messbarer Pilot mit wirtschaftlicher Aussagekraft. Phase 1 Analyse in Woche 1-3 mit Selbsttest und Baseline."}, {"id": "assets_downloads_roi_guide_ki_automatisierung_nurovelle_formatvorlagen_final_wichtigste_erkenntnisse", "label": "Die wichtigsten Erkenntnisse", "file_type": "concept", "source_file": "assets/downloads/ROI_GUIDE_KI_AUTOMATISIERUNG_NUROVELLE_Formatvorlagen_FINAL.pdf", "source_location": "Kapitel 11", "source_url": null, "captured_at": null, "author": "Tino Schneider", "contributor": null, "rationale": "ROI kommt vor Technologie; Quick Wins schaffen Akzeptanz; Fachkraefte werden entlastet, nicht entwertet - KI bereitet vor, Menschen entscheiden und tragen Verantwortung; Datenqualitaet entscheidet ueber Wirtschaftlichkeit; ein Pilot muss messbar sein; nicht jedes Potenzial ist sofort ein Projekt."}, {"id": "assets_downloads_roi_guide_ki_automatisierung_nurovelle_formatvorlagen_final_datenqualitaet", "label": "Datenqualitaet als Wirtschaftlichkeitsfaktor", "file_type": "concept", "source_file": "assets/downloads/ROI_GUIDE_KI_AUTOMATISIERUNG_NUROVELLE_Formatvorlagen_FINAL.pdf", "source_location": "Kapitel 1 und 11", "source_url": null, "captured_at": null, "author": "Tino Schneider", "contributor": null, "rationale": "Datenhygiene wird ueberschaetzt: Informationen liegen verteilt in E-Mails, PDFs, Excel-Listen, Netzlaufwerken, ERP-, CRM-Systemen und Papierdokumenten. Ohne brauchbare Daten sinkt der Nutzen jedes KI-Projekts, deshalb gehoert die Datenlage in jede ROI-Bewertung."}, {"id": "assets_downloads_roi_guide_ki_automatisierung_nurovelle_formatvorlagen_final_ki_potenzialanalyse", "label": "Strukturierte KI-Potenzialanalyse als naechster Schritt", "file_type": "concept", "source_file": "assets/downloads/ROI_GUIDE_KI_AUTOMATISIERUNG_NUROVELLE_Formatvorlagen_FINAL.pdf", "source_location": "Kapitel 11, Punkt 7", "source_url": null, "captured_at": null, "author": "Tino Schneider", "contributor": null, "rationale": "Vor Investitionen in Tools, Schnittstellen oder Automatisierungsprojekte sollen Prozesse nuechtern bewertet werden - genau dort setzt die Potenzialanalyse als Angebot an."}, {"id": "assets_downloads_roi_guide_ki_automatisierung_nurovelle_formatvorlagen_final_nurovelle", "label": "Nurovelle", "file_type": "concept", "source_file": "assets/downloads/ROI_GUIDE_KI_AUTOMATISIERUNG_NUROVELLE_Formatvorlagen_FINAL.pdf", "source_location": "Dokumenttitel und Impressum", "source_url": null, "captured_at": null, "author": "Tino Schneider