{"nodes": [{"id": "paket_buero_bueropaket", "label": "B\u00fcropaket (Produktpaket)", "file_type": "document", "source_file": "paket-buero.html", "source_location": "hero / Was ist das B\u00fcropaket?", "source_url": "https://nurovelle.de/homepage/paket-buero.html", "captured_at": null, "author": null, "contributor": null, "rationale": "Als fertiges Produktpaket statt Individualprojekt geschnitten, damit kleine und mittlere Betriebe vier t\u00e4gliche B\u00fcro-Handgriffe in einer Anwendung, einer Anmeldung und einer Datenbank bekommen statt vier getrennter Programme mit Datensalat."}, {"id": "paket_buero_modul_posteingang", "label": "Modul Posteingang (Kategorie und Dringlichkeit)", "file_type": "concept", "source_file": "paket-buero.html", "source_location": "#module", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Einsortierung nach festen, nachvollziehbaren Stichw\u00f6rtern statt Blackbox-KI, damit jede Zuordnung mit einem Klick korrigierbar und f\u00fcr den Betrieb erkl\u00e4rbar bleibt."}, {"id": "paket_buero_modul_bewertungen", "label": "Modul Bewertungsanfragen mit Sperrliste", "file_type": "concept", "source_file": "paket-buero.html", "source_location": "#module", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bewusst nur Bitte um Bewertung plus einmaliges Nachfassen mit Sperrliste; Google-Bewertungen werden ausdr\u00fccklich nicht ausgelesen oder ausgewertet, um Rechts- und Plattformrisiken zu vermeiden."}, {"id": "paket_buero_modul_wissen", "label": "Modul Internes Wissen (nur hinterlegte Antworten)", "file_type": "concept", "source_file": "paket-buero.html", "source_location": "#module", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Gibt ausschlie\u00dflich selbst hinterlegte Inhalte zur\u00fcck und sagt bei fehlendem Treffer ehrlich, dass es nichts findet, statt zu raten - Halluzinationen w\u00e4ren im Betriebsalltag sch\u00e4dlicher als eine Nicht-Antwort."}, {"id": "paket_buero_modul_onboarding", "label": "Modul Onboarding-Checkliste", "file_type": "concept", "source_file": "paket-buero.html", "source_location": "#module", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pr\u00fcft nur, ob eine Pflichtposition als eingegangen markiert wurde; die inhaltliche Pr\u00fcfung bleibt bewusst beim Kunden."}, {"id": "paket_buero_preis_399_69", "label": "Preis B\u00fcropaket: 399 \u20ac Einrichtung, 69 \u20ac/Monat", "file_type": "concept", "source_file": "paket-buero.html", "source_location": "#preis", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Einf\u00fchrungspreis f\u00fcr Abschl\u00fcsse bis 31.12.2026, netto zzgl. 19 % MwSt., Mindestlaufzeit 12 Monate, danach monatlich k\u00fcndbar."}, {"id": "paket_buero_buendelrabatt", "label": "B\u00fcndelpreis bei weiterem Paket (349 \u20ac / 39 \u20ac)", "file_type": "concept", "source_file": "paket-buero.html", "source_location": "#preis", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ein weiteres Paket l\u00e4uft auf derselben Installation mit, deshalb geringerer Einrichtungs- und Servicepreis."}, {"id": "paket_buero_eigene_instanz", "label": "Eigene getrennte Instanz auf eigenem EU-Server", "file_type": "rationale", "source_file": "paket-buero.html", "source_location": "hero / #preis", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Kein zentraler Anbieterdienst und keine geteilte Datenbank: Software und Daten geh\u00f6ren dem Kunden, der Serververtrag l\u00e4uft auf seinen Namen, und die Software l\u00e4uft auch ohne den Anbieter weiter. Nur die Aktualisierungen h\u00e4ngen am Servicevertrag."}, {"id": "paket_buero_servicevertrag", "label": "Servicevertrag B\u00fcropaket (Aktualisierungen, Support)", "file_type": "concept", "source_file": "paket-buero.html", "source_location": "#leistungsumfang", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "paket_buero_datenschutz", "label": "Datenschutzkonzept B\u00fcropaket (DE/EU, TLS, L\u00f6schfristen, AVV)", "file_type": "concept", "source_file": "paket-buero.html", "source_location": "#datenschutz", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Der Posteingang speichert zwangsl\u00e4ufig Inhalte fremder E-Mails (Absender, Betreff, Text); das wird offen benannt und soll im eigenen Datenschutz-Konzept ber\u00fccksichtigt werden. AVV-Vorlage liegt bei, ist aber vor Produktivbetrieb rechtlich zu pr\u00fcfen."}, {"id": "paket_buero_ehrlicher_stand", "label": "Ehrlicher Stand: noch kein Produktivkunde, Pilot-Deploy offen", "file_type": "rationale", "source_file": "paket-buero.html", "source_location": "#module", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Das Paket ist gebaut und automatisiert getestet, lief aber noch bei keinem Kunden produktiv. Der Reifegrad wird offengelegt statt kaschiert; vor dem ersten Einsatz steht ein Pilot-Deploy mit echtem Postfach. Ebenso wird der Nutzen bewusst nur qualitativ beschrieben, ohne erfundene Zahlen oder Erfolgsversprechen."}, {"id": "paket_buero_cta_anfrage", "label": "CTA: B\u00fcropaket anfragen / Erstgespr\u00e4ch vereinbaren", "file_type": "concept", "source_file": "paket-buero.html", "source_location": "#preis", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "paket_buero_faq", "label": "FAQ B\u00fcropaket", "file_type": "document", "source_file": "paket-buero.html", "source_location": "#faq", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "paket_buero_bueropaket", "target": "paket_buero_modul_posteingang", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "paket-buero.html", "