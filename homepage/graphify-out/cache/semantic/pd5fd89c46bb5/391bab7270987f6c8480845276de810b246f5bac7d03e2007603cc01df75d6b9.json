html", "source_location": "#datenschutz - identischer Baukasten (DE/EU, getrennte Instanz, TLS, Hash, Protokoll, AVV-Vorlage)", "weight": 1.0}], "hyperedges": [{"id": "gemeinsames_paketgeschaeftsmodell", "label": "Gemeinsames Paket-Gesch\u00e4ftsmodell: eigener EU-Server, Servicevertrag, B\u00fcndelpreis", "nodes": ["paket_buero_bueropaket", "paket_handwerk_handwerkspaket", "paket_buero_eigene_instanz", "paket_buero_buendelrabatt", "paket_handwerk_buendelrabatt"], "relation": "form", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "paket-buero.html"}]}