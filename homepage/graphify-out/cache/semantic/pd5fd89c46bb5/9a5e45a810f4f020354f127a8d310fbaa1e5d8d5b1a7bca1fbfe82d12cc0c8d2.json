"contributor": null}, {"id": "assets_downloads_case_study_ki_automatisierung_nurovelle_final_prompt_optimierung", "label": "Prompt-Optimierung", "file_type": "concept", "source_file": "assets/downloads/CASE_STUDY_KI_AUTOMATISIERUNG_NUROVELLE_FINAL.pdf", "source_location": "Kap. 4, Investitionstabelle (Workflow / Prompt-Optimierung, 5.000 EUR)", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Die Prompt-Optimierung ist im Szenario C der einmalige Entwicklungsposten (5.000 EUR), der die laufenden API-Kosten \u00fcberhaupt erst in verwertbare Texte \u00fcbersetzt - die Technik entscheidet \u00fcber die Wirtschaftlichkeit des Workflows."}, {"id": "assets_downloads_case_study_ki_automatisierung_nurovelle_final_openai_api", "label": "OpenAI API", "file_type": "concept", "source_file": "assets/downloads/CASE_STUDY_KI_AUTOMATISIERUNG_NUROVELLE_FINAL.pdf", "source_location": "Kap. 4, Investitionstabelle", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "assets_downloads_case_study_ki_automatisierung_nurovelle_final_strukturierte_produktdaten", "label": "Strukturierte Produktdaten", "file_type": "concept", "source_file": "assets/downloads/CASE_STUDY_KI_AUTOMATISIERUNG_NUROVELLE_FINAL.pdf", "source_location": "Kap. 4, Regelbox", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "assets_downloads_case_study_ki_automatisierung_nurovelle_final_menschliche_pruefung", "label": "Menschliche Pr\u00fcfung (Human-in-the-Loop)", "file_type": "concept", "source_file": "assets/downloads/CASE_STUDY_KI_AUTOMATISIERUNG_NUROVELLE_FINAL.pdf", "source_location": "Kap. 2, 4, 6, 7", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Mitarbeitende bleiben im Prozess und pr\u00fcfen kritische Vorg\u00e4nge; Sonderf\u00e4lle bleiben beim Menschen, weil erzwungene Vollautonomie die Fehlerquote und das Projektrisiko erh\u00f6ht."}, {"id": "assets_downloads_case_study_ki_automatisierung_nurovelle_final_einsparpotenzial", "label": "Einsparpotenzial", "file_type": "concept", "source_file": "assets/downloads/CASE_STUDY_KI_AUTOMATISIERUNG_NUROVELLE_FINAL.pdf", "source_location": "Kap. 2-5", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "assets_downloads_case_study_ki_automatisierung_nurovelle_final_roi_amortisation", "label": "ROI und Amortisation", "file_type": "concept", "source_file": "assets/downloads/CASE_STUDY_KI_AUTOMATISIERUNG_NUROVELLE_FINAL.pdf", "source_location": "Kap. 2-5, Kap. 9", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ROI und Amortisation werden ausdr\u00fccklich als Entscheidungskriterien vor dem Rollout genutzt - kein Tool wird gekauft, bevor der Prozess gemessen und gerechnet wurde."}, {"id": "assets_downloads_case_study_ki_automatisierung_nurovelle_final_fehlerquote", "label": "Reduktion der Fehlerquote", "file_type": "concept", "source_file": "assets/downloads/CASE_STUDY_KI_AUTOMATISIERUNG_NUROVELLE_FINAL.pdf", "source_location": "Kap. 1, Kap. 2", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "assets_downloads_case_study_ki_automatisierung_nurovelle_final_abschlussquote", "label": "H\u00f6here Abschlussquote", "file_type": "concept", "source_file": "assets/downloads/CASE_STUDY_KI_AUTOMATISIERUNG_NUROVELLE_FINAL.pdf", "source_location": "Kap. 3, Regelbox", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "assets_downloads_case_study_ki_automatisierung_nurovelle_final_szenarienvergleich", "label": "Vergleich der drei Szenarien", "file_type": "concept", "source_file": "assets/downloads/CASE_STUDY_KI_AUTOMATISIERUNG_NUROVELLE_FINAL.pdf", "source_location": "Kap. 5", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "assets_downloads_case_study_ki_automatisierung_nurovelle_final_erfolgsfaktoren", "label": "Gemeinsame Erfolgsfaktoren der Automatisierung", "file_type": "concept", "source_file": "assets/downloads/CASE_STUDY_KI_AUTOMATISIERUNG_NUROVELLE_FINAL.pdf", "source_location": "Kap. 6", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "assets_downloads_case_study_ki_automatisierung_nurovelle_final_startprozess_auswahl", "label": "Auswahl des idealen Startprozesses", "file_type": "rationale", "source_file": "assets/downloads/CASE_STUDY_KI_AUTOMATISIERUNG_NUROVELLE_FINAL.pdf", "source_location": "Kap. 6, Zielbox", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Der ideale Startprozess ist nicht der spektakul\u00e4rste, sondern der h\u00e4ufige, messbare und regelbasierte Prozess mit klarer Entlastungswirkung - Standardf\u00e4lle werden automatisiert, Sonderf\u00e4lle bewusst nicht."}, {"id": "assets_downloads_case_study_ki_automatisierung_nurovelle_final_pilotprozess", "label": "Pilotprozess und Parallelbetrieb", "file_type": "concept", "source_file": "assets/downloads/CASE_STUDY_KI_AUTOMATISIERUNG_NUROVELLE_FINAL.pdf", "source_location": "Kap. 6, Kap. 8", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "assets_downloads_case_study_ki_automatisierung_nurovelle_final_einfuehrungsschritte", "label": "30-Tage-Fahrplan (Einf\u00fchrungsschritte)", "file_type": "concept", "source_file": "assets/downloads/CASE_STUDY_KI_AUTOMATISIERUNG_NUROVELLE_FINAL.pdf", "source_location": "Kap. 8", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Vier Wochen: (1) Prozess ausw\u00e4hlen, Zeit messen, ROI rechnen; (2) Daten pr\u00fcfen, Standards definieren, Tool/Workflow ausw\u00e4hlen; (3) Pilotworkflow mit echten Daten testen; (4) Parallelbetrieb, Schulung, erste ROI-Messung. Startregel: Erst messen. Dann rechnen. Dann pilotieren. Danach entscheiden."}, {"id": "assets_downloads_case_study_ki_automatisierung_nurovelle_final_risiken_gegenmassnahmen", "label": "Risiken und Gegenma\u00dfnahmen", "file_type": "concept", "source_file": "assets/downloads/CASE_STUDY_KI_AUTOMATISIERUNG_NUROVELLE_FINAL.pdf", "source_location": "Kap. 7", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "assets_downloads_case_study_ki_automatisierung_nurovelle_final_datencheck", "label": "Datencheck vor Projektstart", "file_type": "concept", "source_file": "assets/downloads/CASE_STUDY_KI_AUTOMATISIERUNG_NUROVELLE_FINAL.pdf", "source_location": "Kap. 7, Kap. 9", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Uneinheitliche oder unvollst\u00e4ndige Daten sind das h\u00e4ufigste Projektrisiko; deshalb Datencheck und Test mit echten Beispieldaten vor jedem Automatisierungsstart."}, {"id": "assets_downloads_case_study_ki_automatisierung_nurovelle_final_plausibilitaetsregeln", "label": "Plausibilit\u00e4tsregeln und Konfidenzschwellen", "file_type": "concept", "source_file": "assets/downloads/CASE_STUDY_KI_AUTOMATISIERUNG_NUROVELLE_FINAL.pdf", "source_location": "Kap. 7", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "assets_downloads_case_study_ki_automatisierung_nurovelle_final_dsgvo_pruefung", "label": "DSGVO-Pr\u00fcfung, AVV und Hosting", "file_type": "concept", "source_file": "assets/downloads/CASE_STUDY_KI_AUTOMATISIERUNG_NUROVELLE_FINAL.pdf", "source_location": "Kap. 7", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "assets_downloads_case_study_ki_automatisierung_nurovelle_final_fallback_prozess", "label": "Fallback-Prozess, Not-Aus und Fehlerprotokoll", "file_type": "concept", "source_file": "assets/downloads/CASE_STUDY_KI_AUTOMATISIERUNG_NUROVELLE_FINAL.pdf", "source_location": "Kap. 7, Warnbox", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keine Automatisierung sollte ohne Not-Aus, Fehlerproto