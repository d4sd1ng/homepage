              <span class="golden-button">
                <svg class="nv-calendly-icon" viewBox="0 0 64 64" aria-hidden="true"><use href="#nv-calendly-mark"></use></svg>
                <span class="golden-text">Kontakt aufnehmen</span>
              </span>
            </a>
          </div>
        </div>
      </section>
    </main>
