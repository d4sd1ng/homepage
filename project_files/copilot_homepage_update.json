  "implementation_process": [
    "Read the complete existing index.html before changing anything.",
    "Identify existing sections, IDs, classes, asset paths and JavaScript hooks.",
    "Compare each section against nurovelle_homepage_visible_content.md.",
    "Replace only outdated visible content.",
    "Add only explicitly required missing structure.",
    "Preserve existing technical functionality.",
    "Check HTML tag integrity after each section.",
    "Do not guess missing asset mappings or URLs.",
    "Run a final desktop and mobile review.",
    "Check the JavaScript console for errors."
  ],
  "validation": {
    "check_html_structure": true,
    "check_closed_tags": true,
    "check_existing_ids": true,
    "check_asset_paths": true,
    "check_form_logic": true,
    "check_honeypot": true,
    "check_success_error_states": true,
    "check_card_animation": true,
    "check_particle_background": true,
    "check_alternating_section_backgrounds": true,
    "check_download_states": true,
    "check_faq_accordion": true,
    "check_footer_links": true,
    "check_mobile_layout": true,
    "check_reduced_motion": true,
    "check_console_errors": true
  },
  "final_report": {
    "required_sections": {
      "GEÄNDERT": [
        "exact changed sections",
        "exact changed texts",
        "exact changed CSS classes",
        "exact changed JavaScript areas"
      ],
      "NICHT_GEÄNDERT": [
        "untouched components",
        "preserved asset paths",
        "preserved technical logic"
      ],
      "OFFEN": [
        "unclear asset mappings",
        "missing real links",
        "missing real download paths"
      ]
    },
    "forbidden_summary": "Do not output only a generic statement such as 'everything updated'."
  }
}
