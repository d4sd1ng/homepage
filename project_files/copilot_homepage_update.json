{
  "task": {
    "name": "Nurovelle Homepage kontrolliert aktualisieren",
    "target_file": "index.html",
    "content_source": "nurovelle_homepage_visible_content.md",
    "technical_sources": [
      "nurovelle-tokens.css",
      "nurovelle-animations.css",
      "shared-header-footer.css",
      "styleguide.md"
    ],
    "goal": "Die freigegebenen sichtbaren Texte, Strukturen, Assets und Interaktionen kontrolliert in die bestehende index.html übernehmen, ohne bestehende Funktionalität oder nicht beauftragte Bereiche zu verändern."
  },
  "global_rules": {
    "no_interpretation": true,
    "no_text_shortening": true,
    "no_text_expansion": true,
    "no_unrequested_layout_changes": true,
    "no_new_sections": true,
    "no_removal_of_approved_sections": true,
    "no_asset_replacement": true,
    "no_asset_path_changes": true,
    "no_id_renaming_without_explicit_instruction": true,
    "no_new_colors": true,
    "no_new_gradients": true,
    "no_new_button_variants": true,
    "no_new_marketing_claims": true,
    "no_new_fallback_overrides": true,
    "no_new_important_rules": true,
    "preserve_existing_html_structure_where_possible": true,
    "preserve_existing_javascript": true,
    "preserve_form_logic": true,
    "preserve_success_error_logic": true,
    "preserve_honeypot": true,
    "preserve_accessibility": true,
    "report_all_changes_exactly": true
